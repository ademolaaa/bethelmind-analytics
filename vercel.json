{
  "version": 2,
  "rewrites": [
    {
      "source": "/affiliates",
      "destination": "/affiliates.html"
    },
    {
      "source": "/affiliate",
      "destination": "/affiliates.html"
    },
    {
      "source": "/partner",
      "destination": "/partner.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/whatsapp/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/scrape/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}